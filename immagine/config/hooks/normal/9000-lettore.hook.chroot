#!/bin/sh
# il lettore parte da solo; nessun login sulla console 1, dove scrive il lettore
set -e
chmod 755 /usr/local/bin/leggi.py
systemctl enable messina-lettore.service systemd-networkd.service
systemctl mask getty@tty1.service
# niente dischi montati, niente swap del PC: il lettore non tocca i dischi
systemctl mask udisks2.service 2>/dev/null || true
echo lettore > /etc/hostname
